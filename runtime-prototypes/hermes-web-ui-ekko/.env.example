# ========================================
# Hermes Web UI (EKKO) - 环境变量配置
# 复制为 .env 后按需修改
# ========================================

# Web UI 访问端口（浏览器打开 http://localhost:8648）
WEBUI_PORT=8648

# Hermes Agent 镜像版本，按需锁定
HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest

# Web UI 镜像（预构建版，无需本地 build）
WEBUI_IMAGE=ekkoye8888/hermes-web-ui:latest

# 容器名称（可按需区分）
HERMES_AGENT_CONTAINER_NAME=hermes-agent
WEBUI_CONTAINER_NAME=hermes-webui

# Hermes 持久化数据目录（Docker 卷挂载点）
HERMES_DATA_DIR=./hermes_data

# 网关上游地址（容器间通信，通常不需改）
UPSTREAM=http://hermes-agent:8642

# Hermes 二进制路径（容器内）
HERMES_BIN=/opt/hermes/.venv/bin/hermes

# 是否禁用认证（开发环境可设 1，生产务必留 false）
AUTH_DISABLED=false
