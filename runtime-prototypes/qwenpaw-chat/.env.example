# Default local target used by the Vite proxy.
VITE_QWENPAW_TARGET=http://127.0.0.1:8088

# Prefix handled by the Vite dev proxy.
VITE_QWENPAW_PROXY_PREFIX=/qwenpaw-api

# Optional request defaults for the QwenPaw console protocol.
VITE_QWENPAW_USER_ID=default_user
VITE_QWENPAW_CHANNEL=console
VITE_QWENPAW_MODEL=
